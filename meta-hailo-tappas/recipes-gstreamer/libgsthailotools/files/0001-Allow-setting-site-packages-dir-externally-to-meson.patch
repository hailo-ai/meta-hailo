From 101e4d09dea8bb5b2d7c2f74d7bcb8487f9f9e74 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Zolt=C3=A1n=20B=C3=B6sz=C3=B6rm=C3=A9nyi?=
 <zboszor@gmail.com>
Date: Thu, 22 Jan 2026 16:28:39 +0100
Subject: [PATCH 1/2] Allow setting site-packages dir externally to meson
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Zoltán Böszörményi <zboszor@gmail.com>
Upstream-Status: Inappropriate [oe specific]
---
 core/hailo/meson.build       | 2 +-
 core/hailo/meson_options.txt | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/core/hailo/meson.build b/core/hailo/meson.build
index fb941d2..559e170 100644
--- a/core/hailo/meson.build
+++ b/core/hailo/meson.build
@@ -56,7 +56,7 @@ if get_option('include_python')
     python_version = 'python' + get_option('python_version')
     python_installation = pymod.find_installation(python_version)
     python_dep = python_installation.dependency(embed : true)
-    python_package_install_dir = run_command(python_version, '-m', 'pip', 'show', 'pip').stdout().split('Location:')[1].split()[0]
+    python_package_install_dir = get_option('python_site_packages_dir')
     pybind_inc = [include_directories(get_option('pybind11'), is_system: true)]
     # Pybind Dependecy
     pybind_dep = declare_dependency(
diff --git a/core/hailo/meson_options.txt b/core/hailo/meson_options.txt
index b851491..8eb4c18 100644
--- a/core/hailo/meson_options.txt
+++ b/core/hailo/meson_options.txt
@@ -8,6 +8,7 @@ option('libxtensor', type : 'string', value : '../../open_source/xtensor_stack/b
 
 # Python requirements
 option('include_python', type : 'boolean', value : false)
+option('python_site_packages_dir', type: 'string', value: '')
 option('pybind11', type : 'string', value : '../../open_source/pybind11/')
 option('python_version', type : 'string', value : '3.6')
 
